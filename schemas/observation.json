{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ink:knowledge:observation:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "program",
    "entries",
    "plan",
    "target",
    "workload",
    "metrics"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "program": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "plan": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware",
        "driver",
        "toolchain",
        "backend",
        "bridge"
      ],
      "properties": {
        "hardware": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "bridge": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "distribution",
        "concurrency",
        "residency"
      ],
      "properties": {
        "shape": {},
        "distribution": {},
        "concurrency": {},
        "residency": {}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_call_ns",
        "peak_bytes"
      ],
      "properties": {
        "complete_call_ns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "peak_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
