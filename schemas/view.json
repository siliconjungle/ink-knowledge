{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/siliconjungle/ink-knowledge/schemas/view.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot",
    "roots",
    "objects",
    "membership"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "semantics",
        "root"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "semantics": {
          "const": "ink-knowledge-snapshot-v1"
        },
        "root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true,
      "maxItems": 1024
    },
    "objects": {
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "kind",
          "semantics",
          "dependencies",
          "interface",
          "payload"
        ],
        "properties": {
          "schema": {
            "const": 1
          },
          "kind": {
            "enum": [
              "definition",
              "theorem",
              "rewrite",
              "implementation",
              "representation",
              "maintenance",
              "bridge"
            ]
          },
          "semantics": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "uniqueItems": true,
            "maxItems": 128
          },
          "interface": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameters",
              "result",
              "operations",
              "effects",
              "conditions"
            ],
            "properties": {
              "parameters": {
                "type": "object"
              },
              "result": {},
              "operations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "effects": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "conditions": {
                "type": "array"
              }
            }
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "membership": {
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entries",
          "path"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "uniqueItems": true,
            "maxItems": 64
          },
          "path": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sibling",
                "left"
              ],
              "properties": {
                "sibling": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "left": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
